<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\AppMorador.Domain\AppMorador.Domain.csproj" />
    <ProjectReference Include="..\AppMorador.Jfl\AppMorador.Jfl.csproj" />
    <ProjectReference Include="..\AppMorador.Infrastructure\AppMorador.Infrastructure.csproj" />
    <ProjectReference Include="..\AppMorador.Application\AppMorador.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>752195b8-1e51-4397-bc77-b66da4cb95f9</UserSecretsId>
    <!-- Sprint 22B (ADR 0031) — habilita o Swagger a ler os comentários /// já escritos nos
         Controllers/DTOs. CS1591 (endpoint sem comentário) é suprimido de propósito: exigir
         comentário em toda a Api existente seria refatoração massiva fora do escopo desta
         Sprint — Controllers novos já documentados servem de padrão para o restante crescer
         organicamente. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
