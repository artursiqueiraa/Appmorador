# Template de variaveis de ambiente do Backend (AppMorador.Api) — Sprint 17.5.
#
# IMPORTANTE: o Backend NAO le um arquivo .env automaticamente (nao ha pacote
# tipo DotNetEnv referenciado) — ASP.NET Core le variaveis de ambiente reais
# do processo diretamente (convencao "__" para secoes aninhadas do
# appsettings.json). Este arquivo e um TEMPLATE/REFERENCIA do nome exato de
# cada variavel para configurar producao (systemd, IIS, Docker, etc.) — em
# desenvolvimento local, use `dotnet user-secrets` (ver docs/ENVIRONMENT.md e
# docs/setup/SETUP_AMBIENTE.md), nunca escreva segredo real neste arquivo.
#
# Para usar em producao (exemplo genérico, adaptar ao shell/orquestrador):
#   $env:ConnectionStrings__DefaultConnection = "Server=...;Port=3306;Database=appmorador;User=...;Password=...;"
#   $env:Jwt__Key = "<chave-aleatoria-de-64+-bytes>"

# Connection string do MySQL (Pomelo.EntityFrameworkCore.MySql) — nunca committar com senha real.
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=appmorador;User=appmorador;Password=CHANGE_ME;

# Chave de assinatura JWT — obrigatoria, sem valor padrao (a Api recusa subir sem ela, por design).
# Gerar uma chave aleatoria forte, ex.: openssl rand -base64 64
Jwt__Key=CHANGE_ME_RANDOM_64_BYTES_MINIMUM

# Opcionais — ja tem valor padrao no appsettings.json, sobrescrever so se necessario.
Jwt__Issuer=AppMorador
Jwt__Audience=AppMoradorApp
Jwt__AccessTokenMinutes=20
Jwt__RefreshTokenDays=30

# Porta do servidor TCP do protocolo JFL (centrais de alarme) — opcional, padrao 8085.
Jfl__Porta=8085
Jfl__IntervaloKeepAliveMinutos=5

# Pasta onde snapshots de camera capturados no disparo sao salvos — opcional, padrao "snapshots".
Snapshots__BasePath=snapshots
Snapshots__TimeoutSeconds=5

# Origens permitidas por CORS (mobile em dev usa o Metro bundler, porta 8081) — lista separada
# por indice (ASP.NET Core nao aceita array via env var simples; ver docs/ENVIRONMENT.md).
Cors__AllowedOrigins__0=http://localhost:8081

# Ambiente ASP.NET Core (Development habilita Swagger e seed automatico de dev).
ASPNETCORE_ENVIRONMENT=Development
